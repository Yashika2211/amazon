# Local development needs none of these: `pnpm dev` runs on an in-memory store with a seeded demo household.
# In AWS, infra/template.yaml sets them from stack parameters.

# Server
PORT=8787
PUBLIC_BASE_URL=                 # e.g. https://xyz.lambda-url.us-east-1.on.aws (derived from the request when empty)
LOG_LEVEL=info
DEMO_MODE=true                   # enables /simulator and /api/demo/* for the fictional demo household
DEMO_LOCAL_TIME=                 # e.g. 08:20 to pin the household clock for a repeatable demo

# AWS (leave TABLE_NAME empty for the in-memory store)
AWS_REGION=us-east-1
TABLE_NAME=
SNS_TOPIC_ARN=
SMS_ENABLED=false
DIGEST_FUNCTION_NAME=            # async Lambda for the Bedrock digest; in-process when empty
DIGEST_WRITER=                   # "bedrock" to call Bedrock locally, "template" to force the template
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-lite-v1:0
SIM_ORCHESTRATOR=                # "keyword" to skip Bedrock in the simulator
SIM_MODEL_ID=                    # Bedrock model for the simulated Alexa+ orchestrator (defaults to BEDROCK_MODEL_ID)

# OAuth client for Alexa+ account linking
ALEXA_CLIENT_ID=alexa-kinloop
ALEXA_CLIENT_SECRET=             # local only; in AWS the secret lives in SSM (ALEXA_CLIENT_SECRET_PARAM)
ALEXA_CLIENT_SECRET_PARAM=
ALEXA_REDIRECT_URIS=             # comma-separated, from the Alexa+ Developer Hub
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=7776000

# Optional Telegram alert channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_PARAM=

# Demo alert recipients (applied when the demo household is reset)
DEMO_CAREGIVER_EMAIL=
DEMO_CAREGIVER_PHONE=
DEMO_CAREGIVER_TELEGRAM_CHAT_ID=

# Web app, only when hosting it on a different origin from the server
NEXT_PUBLIC_API_BASE=
